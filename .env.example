# Copy to .env on the server and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=192.168.1.50,example.com
# Needed when served over HTTPS behind a proxy/tunnel:
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# Full path of the script run by the 啟動unraid button, and its timeout (seconds)
DJANGO_UNRAID_SCRIPT=/var/www/RpiHcs/scripts/start_unraid.sh
DJANGO_UNRAID_SCRIPT_TIMEOUT=60
